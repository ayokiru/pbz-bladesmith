+
+/// Read+Seek over a container split into several .ucas partitions.
+/// Global offsets map to partition = offset / partition_size.
+struct PartitionedCas<'a> {
+    pools: &'a [FilePool],
+    handles: Vec<Option<crate::file_pool::PooledFileHandle>>,
+    partition_size: u64,
+    cur: usize,
+}
+impl PartitionedCas<'_> {
+    fn handle(&mut self, i: usize) -> std::io::Result<&mut fs::File> {
+        if i >= self.pools.len() {
+            return Err(std::io::Error::other(format!("partition {i} out of range")));
+        }
+        if self.handles[i].is_none() {
+            self.handles[i] = Some(self.pools[i].acquire()?);
+        }
+        Ok(self.handles[i].as_mut().unwrap().file())
+    }
+}
+impl std::io::Read for PartitionedCas<'_> {
+    fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+        let c = self.cur;
+        self.handle(c)?.read(buf)
+    }
+}
+impl std::io::Seek for PartitionedCas<'_> {
+    fn seek(&mut self, pos: std::io::SeekFrom) -> std::io::Result<u64> {
+        match pos {
+            std::io::SeekFrom::Start(off) => {
+                let (part, local) = if self.pools.len() > 1 && self.partition_size > 0 { ((off / self.partition_size) as usize, off % self.partition_size) } else { (0, off) };
+                self.cur = part;
+                self.handle(part)?.seek(std::io::SeekFrom::Start(local))?;
+                Ok(off)
+            }
+            other => {
+                let c = self.cur;
+                let local = self.handle(c)?.seek(other)?;
+                Ok(c as u64 * self.partition_size + local)
+            }
+        }
+    }
+}
